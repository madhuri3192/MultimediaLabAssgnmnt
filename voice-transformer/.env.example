# Copy to .env.local (never commit .env.local).
#
# Create a dedicated ElevenLabs API key for this app. Restrict it to the
# Speech-to-Speech / Voice Changer permission and give it a small monthly
# credit cap. Rotate it immediately if it is ever exposed.
ELEVENLABS_API_KEY=

# Voice IDs. At least one is required; unset voices are hidden.
# On the FREE plan only two kinds of voice work through the API:
#   - voices you generated with Voice Design and saved (category "generated")
#   - ElevenLabs' current built-in default voices (category "premade"),
#     e.g. George JBFqnCBsd6RMkjVDRZzb or Sarah EXAVITQu4vr4xnSDxMaL
# Voices added from the Voice Library (including legacy defaults like Rachel or
# Adam) fail with 402 paid_plan_required. Verify with: pnpm check:elevenlabs --probe
ELEVENLABS_VOICE_WARM_ID=
ELEVENLABS_VOICE_DEEP_ID=
ELEVENLABS_VOICE_BRIGHT_ID=

# --- Optional -----------------------------------------------------------------

# Speech-to-speech model. The multilingual model handles English, Hindi and Hinglish.
# ELEVENLABS_MODEL_ID=eleven_multilingual_sts_v2

# Ask ElevenLabs to isolate the voice from background noise before converting.
# ELEVENLABS_REMOVE_BACKGROUND_NOISE=false

# How long to wait for ElevenLabs before giving up (5000–120000).
# ELEVENLABS_TIMEOUT_MS=45000

# Product limits. Keep these small: the free plan gives roughly 10 minutes of
# Voice Changer per month. On Vercel, request bodies are capped at 4.5 MB, so
# set MAX_AUDIO_SIZE_MB=4 there so the browser rejects large files up front.
# MAX_AUDIO_DURATION_SECONDS=30
# MAX_AUDIO_SIZE_MB=15
